# Copy to .env and chmod 600 .env. Never commit .env.
PORT=8788
PAYMENTS_LIVE=false
DECISIONS_LIVE=false
TWITCH_CONNECT=false
TWITCH_SIGNALS=false
TWITCH_POLLS=false
TWITCH_SUBSCRIPTIONS=false
TWITCH_AUTO_SESSION=false
OPENAI_API_KEY=
# A NEW Hosted Test extension registration is required.
TWITCH_EXT_CLIENT_ID=
TWITCH_EXT_SECRET=
TWITCH_EXT_OWNER_ID=
TWITCH_BROADCASTER_ID=
TWITCH_CLIENT_ID=
TWITCH_USER_ID=
TWITCH_TOKEN=
TWITCH_REFRESH_TOKEN=
PUBLIC_HOST=notes.example.test
EBS_PUBLIC_URL=https://notes.example.test
OBS_FRAME_WATCHER=false
OBS_GAME_PROFILE=generic
# Optional JSON preset, imported atomically at startup (replaces event definitions).
EVENTS_PRESET_FILE=
# Separate private loopback trigger credential. Generate privately; never put it in a URL.
EVENTS_API_TOKEN=
OBS_WS_URL=ws://127.0.0.1:4455
OBS_SOURCE_NAME=
OBS_PASSWORD=
# Capture at 5 Hz; demo default reviews five frames once per second.
OBS_FRAME_WIDTH=640
OBS_FRAME_HEIGHT=360
# window: review all five frames once per second for the demo.
# screened: one-image triage, five-image review only on demand.
OBS_REVIEW_MODE=window
# Screened mode gate only; event min_confidence still applies to full review.
OBS_REVIEW_CONFIDENCE=0.60
ASTRA_CONDITIONS=false
SPEECH_WATCHER=false
SPEECH_TRANSCRIPT_FILE=data/transcripts/stream.jsonl
